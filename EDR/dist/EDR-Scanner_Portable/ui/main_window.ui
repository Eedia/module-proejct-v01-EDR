  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">
QWidget#centralwidget { background:#1e1f23; color:#e5e7eb; }

/* 패널 공통 */
QFrame#panel, QFrame#panel2 { background:#2a2c31; border-radius:8px; }
QLabel.title   { color:#e5e7eb; font-weight:700; }
QLabel.muted   { color:#a3a7b0; }
QLabel.good    { color:#6ee777; font-weight:600; }
QLabel.bad     { color:#ef4444; font-weight:600; }
QLabel.neutral { color:#cbd5e1; }

/* 진행바 */
QProgressBar#safeBar {
  background:#1f2126; border:1px solid #00000066; border-radius:6px; height:14px; text-align:right;
}
QProgressBar#safeBar::chunk { background:#22c55e; border-radius:6px; }
QLabel#redDot { color:#ef4444; font-size:12pt; }

/* 점수 박스 */
QFrame#scoreBox { background:#2a2c31; border-radius:8px; border:1px solid #00000066; }
QLabel#scoreTitle { color:#a3a7b0; font-weight:600; }
QLabel#scoreValue { color:#e5e7eb; font-size:28pt; font-weight:700; }
QLabel#scoreHint  { color:#a3a7b0; font-size:9pt; }

/* 버튼 */
QPushButton#btnStart, QPushButton#btnHTML {
  background:#0ea5ff; color:white; font-weight:600;
  border:none; border-radius:6px; padding:6px 12px;
}
QPushButton#btnStart:hover, QPushButton#btnHTML:hover { background:#0284c7; }
    </string>
