  background:#0f1115; border:1px solid #00000066; border-radius:6px;
  padding:8px; color:#e5e7eb;
}
QPushButton#btnSend {
  background:#0ea5ff; color:white; font-weight:600; border:none; border-radius:6px; padding:6px 12px;
}
QPushButton#btnSend:hover { background:#0284c7; }
QPushButton#btnStop {
  background:#374151; color:#e5e7eb; border:none; border-radius:6px; padding:6px 12px;
}
