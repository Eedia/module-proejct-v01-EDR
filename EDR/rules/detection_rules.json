    {
      "rule_id": "R_POWERSHELL_ENCODED",
      "category": "execution",
      "subcategory": "powershell",
      "title": "PowerShell 인코딩된 명령어",
      "description": "PowerShell에서 Base64 인코딩된 명령어 실행 탐지",
      "severity": "medium",
      "confidence": 75,
      "tactics": ["execution", "defense_evasion"],
      "techniques": ["T1059.001", "T1027"],
      "data_source": "event_log",
      "log_channels": ["Microsoft-Windows-PowerShell/Operational"],
      "event_ids": [4104, 4103],
      "conditions": {
        "process_name": ["powershell.exe", "pwsh.exe"],
        "command_line_contains": ["-enc", "-EncodedCommand", "FromBase64String"],
        "logic": "OR"
      },
      "weight": 1.2,
      "enabled": true
    },
    {
      "rule_id": "R_POWERSHELL_BYPASS_POLICY",
      "category": "execution",
      "subcategory": "powershell",
      "title": "PowerShell 실행 정책 우회",
      "description": "PowerShell 실행 정책을 우회하려는 시도 탐지",
      "severity": "medium",
      "confidence": 80,
      "tactics": ["execution", "defense_evasion"],
      "techniques": ["T1059.001"],
      "data_source": "event_log",
      "log_channels": ["Microsoft-Windows-PowerShell/Operational"],
      "event_ids": [4104, 4103],
      "conditions": {
        "command_line_contains": ["-ExecutionPolicy", "Bypass", "Unrestricted", "-ep"],
        "logic": "OR"
      },
      "weight": 1.1,
      "enabled": true
    },
    {
      "rule_id": "CFG_PS_EXECUTIONPOLICY_WEAK",
      "category": "configuration", "subcategory": "security_settings",
      "title": "보안 설정 미준수",
      "description": "PowerShell ExecutionPolicy가 Bypass/Unrestricted",
      "severity": "low", "confidence": 90,
      "tactics": ["defense_evasion"], "techniques": ["T1112"],
      "data_source": "registry",
      "registry_keys": ["HKLM\\SOFTWARE\\Microsoft\\PowerShell\\1\\ShellIds\\Microsoft.PowerShell"],
      "conditions": { "value_name_contains": ["ExecutionPolicy"], "value_contains": ["bypass", "unrestricted"], "logic": "OR" },
      "weight": 0.8, "enabled": true
    },
    {
      "rule_id": "R_POWERSHELL_AMSI_BYPASS",
      "category": "execution",
      "subcategory": "powershell",
